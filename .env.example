# Gemini: https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Copy these from your FalkorDB Cloud connection details.
# HOST is a hostname, without https:// or a port suffix.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=
# Set true when the database connection details require TLS.
FALKORDB_SSL=false
FALKORDB_GRAPH=promisegraph_demo

# Hosted demo: set APP_ENV=production and supply a strong shared login.
# Render always requires credentials, even if AUTH_REQUIRED=false.
APP_ENV=local
AUTH_REQUIRED=false
DEMO_USERNAME=
DEMO_PASSWORD=
# Optional fixed deadline for temporary public access; blank keeps login required.
# Use an ISO timestamp with timezone. Credentials and limits remain required.
PUBLIC_DEMO_UNTIL=
AI_REQUESTS_PER_MINUTE=6
AI_REQUESTS_PER_HOUR=60
WRITE_REQUESTS_PER_MINUTE=30
AI_MAX_CONCURRENT=2
